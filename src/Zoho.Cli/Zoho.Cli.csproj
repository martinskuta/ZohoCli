<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zoho.Cli</RootNamespace>
    <AssemblyName>zoho</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zoho</ToolCommandName>
    <PackageId>Zoho.Cli</PackageId>
    <Version>1.0.0</Version>
    <Description>Reads Zoho People leaves and timesheet jobs as JSON.</Description>
    <RepositoryUrl>https://github.com/martinskuta/zohocli</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zoho.Cli.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>